// User-defined functions, recursion and array-built polygons.
//
// Demonstrates: function definitions with parameters, return, recursion (a Koch
// snowflake and a factorial), and building point arrays with ptlist[i] = ...
// that are drawn by polygon_mat.

clear_fig();
axis();

// A recursive function: n!
factorial(n)
{
    if ( n <= 1 ) { return 1; }
    return n * factorial(n - 1);
}

// One segment of the Koch curve, recursed depth times.
koch(x1, y1, x2, y2, depth)
{
    if ( depth == 0 ) {
        line(x1, y1, x2, y2);
        return 0;
    }
    var dx = (x2 - x1) / 3, dy = (y2 - y1) / 3;
    var ax = x1 + dx, ay = y1 + dy;
    var bx = x1 + 2 * dx, by = y1 + 2 * dy;
    var cx = (ax + bx) / 2 - 0.8660254 * dy;    // bump the middle third outward
    var cy = (ay + by) / 2 + 0.8660254 * dx;

    koch(x1, y1, ax, ay, depth - 1);
    koch(ax, ay, cx, cy, depth - 1);
    koch(cx, cy, bx, by, depth - 1);
    koch(bx, by, x2, y2, depth - 1);
    return 0;
}

// Koch snowflake: the same curve on the three sides of a triangle.
write_fig_config("border_color", named_color("darkBlue"));
koch(-3, -1, 3, -1, 3);
koch(3, -1, 0, 4.2, 3);
koch(0, 4.2, -3, -1, 3);

// A star built in a loop into a point array, then drawn by polygon_mat.
star(R, r, points, cx, cy)
{
    var ptlist, i;
    for ( i = 0; i < 2 * points; i++ ) {
        var rad = i * PI / points;
        var radius;
        if ( i % 2 == 0 ) { radius = R; } else { radius = r; }
        var pt = parm_circle(rad, radius);
        ptlist[i] = array(2, cx + pt[0], cy + pt[1]);
    }
    polygon_mat(ptlist);
}

write_fig_config("fill_color", named_color("gold"));
star(1.6, 0.7, 5, 5.5, 3);

// A user function called inside an expression.
write_fig_config("font_color", named_color("black"));
draw_text("10! = " + factorial(10), -7, -4.5, 0, 0.8);
draw_text("Koch snowflake (recursion) and polygon_mat star", -7, 5.3, 0, 0.7);
