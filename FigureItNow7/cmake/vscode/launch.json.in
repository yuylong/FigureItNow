{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug",
            "type": "cppdbg",
            "request": "launch",
            "program": "@FIN_VSCODE_DEBUG_PROGRAM@",
            "args": [],
            "stopAtEntry": false,
            "cwd": "@FIN_VSCODE_SOURCE_DIR@",
            "environment": @FIN_VSCODE_LAUNCH_ENVIRONMENT@,
            "externalConsole": false,
            @FIN_VSCODE_LAUNCH_DEBUGGER@
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "CMake: Build Debug"
        },
        {
            "name": "Release",
            "type": "cppdbg",
            "request": "launch",
            "program": "@FIN_VSCODE_DEBUG_PROGRAM@",
            "args": [],
            "stopAtEntry": false,
            "cwd": "@FIN_VSCODE_SOURCE_DIR@",
            "environment": @FIN_VSCODE_LAUNCH_ENVIRONMENT@,
            "externalConsole": false,
            @FIN_VSCODE_LAUNCH_DEBUGGER@
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "CMake: Build Release"
        }
    ]
}
