<?xml version="1.0"?>
<!--
  FigureItNow7 component metadata

  build_installer.ps1 renders this file, substituting actual values for <Version>
  and <ReleaseDate>. Do not spell the placeholders out inside comments, or they
  get replaced too.

  The identifier follows the io.github.<user>.<app> reverse-DNS convention used by
  individual open-source projects, matching the io.github.yuylong namespace on
  GitHub Pages. It must never change after the first public release, otherwise
  installed users stop receiving updates.
-->
<Package>
    <!--
      Base metadata is English-only for now. Localized variants are added later by
      repeating the element with an xml:lang attribute, e.g.
        <Description xml:lang="zh_CN">...</Description>
      The installer UI translation is configured separately in config.xml.
    -->
    <DisplayName>FigureItNow7</DisplayName>

    <Description>Draw mathematical figures with a small script language.</Description>

    <Version>@APP_VERSION@</Version>
    <ReleaseDate>@RELEASE_DATE@</ReleaseDate>
    <Name>io.github.yuylong.figureitnow7</Name>

    <!--
      The license page renders the file as rich text: IFW hands the file content to
      QTextBrowser::setText(), which auto-detects HTML (the file must therefore start
      with a tag, e.g. the DOCTYPE above). Links inside the text open in the default
      browser. Localized variants follow the <base>_<locale>.<suffix> naming.
    -->
    <Licenses>
        <License name="GNU General Public License v3.0" file="license.html" />
    </Licenses>

    <!-- Creates the Start menu and desktop shortcuts; the file must be listed here to be packaged. -->
    <Script>installscript.qs</Script>

    <!--
      The application is mandatory, but ForcedInstallation is deliberately NOT used:
      IFW renders forced components without any check box at all. Instead the script
      locks the component with component.enabled = false, which shows a grayed,
      always-checked check box that neither clicks nor the "reset to default" /
      "uncheck all" actions can change. See installscript.qs.
    -->
    <Default>true</Default>
    <RequiresAdminRights>true</RequiresAdminRights>

    <!-- Root components are sorted by descending SortingPriority; a tie is broken by
         display name, which would put "Example Scripts" above the application. -->
    <SortingPriority>100</SortingPriority>
</Package>
